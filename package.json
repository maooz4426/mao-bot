{
	"name": "mao-bot",
	"version": "1.0.0",
	"description": "",
	"main": "index.js",
	"scripts": {
		"dev": "tsx --env-file=dev.env src/index.ts",
		"start": "node dist/index.js",
		"build": "tsc",
		"lint": "biome lint .",
		"format": "biome format --write .",
		"check": "biome check --write .",
		"patch-dev": "tsx --env-file=dev.env src/patches/register-commands.ts",
		"patch-prod": "tsx --env-file=dev.env src/patches/register-commands.ts"
	},
	"keywords": [],
	"author": "",
	"license": "ISC",
	"devEngines": {
		"packageManager": {
			"name": "pnpm",
			"version": "11.18.0",
			"onFail": "download"
		}
	},
	"type": "module",
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^26.2.0",
		"tsx": "^4.23.12",
		"typescript": "^7.0.2"
	},
	"dependencies": {
		"discord.js": "^14.27.0",
		"dotenv": "^17.4.2"
	}
}
